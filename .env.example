# Hostname dưới đây dành cho service chạy BÊN TRONG mạng docker-compose.
# Script chạy trực tiếp trên máy host (vd `cd ml && python src/train.py`) phải dùng:
#   KAFKA_BOOTSTRAP_SERVERS=localhost:29092, MLFLOW_TRACKING_URI=http://localhost:5000, POSTGRES_HOST=localhost

# --- PostgreSQL / TimescaleDB ---
POSTGRES_USER=rpm_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=rpm_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_VITALS=vitals-stream
KAFKA_TOPIC_PREDICTIONS=predictions-stream
KAFKA_TOPIC_ALERTS=alerts-stream
# Sự kiện MLOps (Airflow → backend): drift_report, retrain_completed
KAFKA_TOPIC_MLOPS=mlops-events

# --- Replay (producer) ---
# 1 giờ dữ liệu MIMIC được phát lại trong bao nhiêu giây thật
REPLAY_SECONDS_PER_DATA_HOUR=5

# --- Stream consumer (tùy chọn, có giá trị mặc định) ---
# KAFKA_CONSUMER_GROUP=rpm-stream-consumer
# MODEL_REFRESH_SECONDS=60            # chu kỳ kiểm tra alias champion trên MLflow
# ALERT_SETTINGS_REFRESH_SECONDS=30   # chu kỳ đọc lại alert_settings (Admin đổi ngưỡng)

# --- Backend (FastAPI) ---
BACKEND_SECRET_KEY=changeme-generate-a-random-secret
BACKEND_JWT_ALGORITHM=HS256
BACKEND_ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=http://localhost:5173
# Tùy chọn, có giá trị mặc định:
# BACKEND_KAFKA_GROUP=rpm-backend      # consumer group của Kafka listener; đổi = đọc lại từ latest
# KAFKA_LISTENER_ENABLED=true          # false = tắt listener (bộ test backend dùng false)
# RETRAIN_DAG_ID=retrain_pipeline      # DAG mà UC10 kích hoạt qua Airflow REST

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000

# --- Airflow ---
AIRFLOW_WWW_USER=admin
AIRFLOW_WWW_PASSWORD=changeme
AIRFLOW_API_URL=http://airflow-webserver:8080/api/v1
# Chu kỳ DAG drift_check; 2 phút = 24 giờ dữ liệu ở tốc độ phát lại mặc định (docs/design/02_9 mục 2.9.4)
DRIFT_CHECK_INTERVAL_MINUTES=2

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=changeme

# --- Backend: tài khoản Admin đầu tiên (tạo khi chưa có Admin nào) — ĐỔI mật khẩu khi triển khai ---
ADMIN_EMAIL=admin@rpm.local
ADMIN_PASSWORD=changeme-admin
ADMIN_FULL_NAME=Quản trị viên
# Đường dẫn giao diện, dùng trong link email tới trang chi tiết bệnh nhân
FRONTEND_BASE_URL=http://localhost:5173

# --- Email Alert (SMTP) ---
# log = chỉ ghi log (mặc định, an toàn khi phát triển); smtp = gửi thật qua SMTP bên dưới
EMAIL_DELIVERY=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=changeme
ALERT_EMAIL_FROM=your_email@example.com

# --- Ngưỡng cảnh báo mặc định ---
# Chỉ dùng để seed bảng alert_settings lần đầu; sau đó Admin chỉnh trong UI (UC08).
# Ý nghĩa từng ngưỡng: docs/design/02_9_thiet_ke_giai_thuat.md mục 2.9.6.
# Để trống = dùng τ_critical gắn kèm model champion (tag `tau_critical` trên MLflow).
DEFAULT_RISK_CRITICAL_THRESHOLD=
DEFAULT_ANOMALY_THRESHOLD=0.99
DEFAULT_ALERT_COOLDOWN_HOURS=4

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
