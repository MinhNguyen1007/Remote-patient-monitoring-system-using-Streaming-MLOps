# Hostname dưới đây dành cho service chạy BÊN TRONG mạng docker-compose.
# Script chạy trực tiếp trên máy host (vd `cd ml && python src/train.py`) phải dùng:
#   KAFKA_BOOTSTRAP_SERVERS=localhost:29092, MLFLOW_TRACKING_URI=http://localhost:5000, POSTGRES_HOST=localhost

# --- PostgreSQL / TimescaleDB ---
POSTGRES_USER=rpm_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=rpm_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_VITALS=vitals-stream
KAFKA_TOPIC_PREDICTIONS=predictions-stream
KAFKA_TOPIC_ALERTS=alerts-stream

# --- Replay (producer) ---
# 1 giờ dữ liệu MIMIC được phát lại trong bao nhiêu giây thật
REPLAY_SECONDS_PER_DATA_HOUR=5

# --- Backend (FastAPI) ---
BACKEND_SECRET_KEY=changeme-generate-a-random-secret
BACKEND_JWT_ALGORITHM=HS256
BACKEND_ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=http://localhost:5173

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000

# --- Airflow ---
AIRFLOW_WWW_USER=admin
AIRFLOW_WWW_PASSWORD=changeme
AIRFLOW_API_URL=http://airflow-webserver:8080/api/v1

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=changeme

# --- Email Alert (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=changeme
ALERT_EMAIL_FROM=your_email@example.com

# --- Ngưỡng cảnh báo mặc định ---
# Chỉ dùng để seed bảng alert_settings lần đầu; sau đó Admin chỉnh trong UI (UC08).
# Ý nghĩa từng ngưỡng: docs/design/02_9_thiet_ke_giai_thuat.md mục 2.9.6.
DEFAULT_RISK_CRITICAL_THRESHOLD=0.5
DEFAULT_ANOMALY_THRESHOLD=0.99
DEFAULT_ALERT_COOLDOWN_HOURS=4

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
