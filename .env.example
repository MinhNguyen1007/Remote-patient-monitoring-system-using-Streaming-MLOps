# --- PostgreSQL / TimescaleDB ---
POSTGRES_USER=rpm_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=rpm_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_VITALS=vitals-stream

# --- Backend (FastAPI) ---
BACKEND_SECRET_KEY=changeme-generate-a-random-secret
BACKEND_JWT_ALGORITHM=HS256
BACKEND_ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=http://localhost:5173

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://rpm_user:changeme@postgres:5432/airflow_db
AIRFLOW_WWW_USER=admin
AIRFLOW_WWW_PASSWORD=changeme

# --- Email Alert (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=changeme
ALERT_EMAIL_FROM=your_email@example.com

# --- Model thresholds ---
RISK_ALERT_THRESHOLD=critical
ANOMALY_SCORE_THRESHOLD=0.8

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
