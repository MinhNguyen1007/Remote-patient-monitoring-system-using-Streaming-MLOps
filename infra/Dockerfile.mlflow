FROM python:3.11-slim

# Phiên bản MLflow phải trùng với client ở ml/, streaming/, Airflow (client 3.x gọi API mà server 2.x không có).
RUN pip install --no-cache-dir mlflow==3.11.1 psycopg2-binary==2.9.9

WORKDIR /mlflow

EXPOSE 5000

# Shell form (not exec/JSON form) so ${...} env vars are substituted at container start.
# Artifact đi qua proxy của server (mlflow-artifacts:/) rồi mới ghi vào volume /mlflow/artifacts.
# Nếu để --default-artifact-root là đường dẫn local, client (script train trên host, container
# Airflow/consumer) sẽ ghi model vào filesystem của chính nó và các service khác không load được.
# MLflow 3.x mặc định chỉ nhận Host header localhost/IP nội bộ; container khác gọi qua hostname
# "mlflow" sẽ bị 403 nếu không khai báo --allowed-hosts.
CMD mlflow server \
    --backend-store-uri postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/mlflow_db \
    --serve-artifacts \
    --artifacts-destination /mlflow/artifacts \
    --default-artifact-root mlflow-artifacts:/ \
    --allowed-hosts "mlflow,mlflow:*,localhost,localhost:*,127.0.0.1,127.0.0.1:*" \
    --host 0.0.0.0 \
    --port 5000
